# ==========================================
# CUSTOMER BEHAVIOR ANALYSIS PROJECT
# ==========================================

# STEP 1 — IMPORT LIBRARIES

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

# ==========================================
# STEP 2 — LOAD DATASET
# ==========================================

file_path = '../data/ecommerce_customer_data_large.csv'

df = pd.read_csv(
    file_path,
    encoding='latin1',
    engine='python',
    on_bad_lines='skip'
)

# ==========================================
# STEP 3 — DISPLAY DATASET
# ==========================================

print("FIRST 5 ROWS")
print(df.head())

print("\nDATASET SHAPE")
print(df.shape)

print("\nCOLUMN NAMES")
print(df.columns)

print("\nDATASET INFO")
print(df.info())

# ==========================================
# STEP 4 — DATA CLEANING
# ==========================================

# Remove duplicate rows
df.drop_duplicates(inplace=True)

# Check missing values
print("\nMISSING VALUES")
print(df.isnull().sum())

# Fill missing values
df.fillna(0, inplace=True)

# ==========================================
# STEP 5 — STATISTICAL SUMMARY
# ==========================================

print("\nSTATISTICAL SUMMARY")
print(df.describe())

# ==========================================
# STEP 6 — DISTRIBUTION PLOT
# ==========================================

plt.figure(figsize=(8,5))

sns.histplot(
    df.select_dtypes(include='number').iloc[:,0],
    kde=True
)

plt.title("Distribution Plot")

plt.savefig('../visuals/distribution_plot.png')

plt.show()

# ==========================================
# STEP 7 — CORRELATION HEATMAP
# ==========================================

plt.figure(figsize=(12,6))

sns.heatmap(
    df.corr(numeric_only=True),
    annot=True,
    cmap='coolwarm'
)

plt.title("Correlation Heatmap")

plt.savefig('../visuals/correlation_heatmap.png')

plt.show()

# ==========================================
# STEP 8 — FEATURE ENGINEERING
# ==========================================

numeric_cols = df.select_dtypes(include=np.number).columns

print("\nNUMERICAL COLUMNS")
print(numeric_cols)

# Create Frequency and Monetary Features
df['Frequency'] = df[numeric_cols[0]]

df['Monetary'] = df[numeric_cols[1]]

# ==========================================
# STEP 9 — CUSTOMER SEGMENTATION
# ==========================================

features = df[['Frequency', 'Monetary']]

# Scale data
scaler = StandardScaler()

scaled_data = scaler.fit_transform(features)

# Apply KMeans Clustering
kmeans = KMeans(
    n_clusters=4,
    random_state=42
)

df['Cluster'] = kmeans.fit_predict(scaled_data)

print("\nCLUSTERING COMPLETED!")

print(df[['Frequency', 'Monetary', 'Cluster']].head())

# ==========================================
# STEP 10 — CUSTOMER SEGMENTATION VISUALIZATION
# ==========================================

plt.figure(figsize=(8,5))

sns.scatterplot(
    x=df['Frequency'],
    y=df['Monetary'],
    hue=df['Cluster'],
    palette='Set2'
)

plt.title("Customer Segmentation")

plt.savefig('../visuals/customer_segmentation.png')

plt.show()

# ==========================================
# STEP 11 — CHURN ANALYSIS
# ==========================================

df['Churn_Risk'] = np.where(
    df['Frequency'] < df['Frequency'].median(),
    'High',
    'Low'
)

# ==========================================
# STEP 12 — CHURN VISUALIZATION
# ==========================================

plt.figure(figsize=(6,4))

sns.countplot(
    x='Churn_Risk',
    data=df
)

plt.title("Churn Risk Analysis")

plt.savefig('../visuals/churn_analysis.png')

plt.show()

# ==========================================
# STEP 13 — SAVE PROCESSED DATASET
# ==========================================

df.to_csv(
    '../data/processed_customer_behavior.csv',
    index=False
)

print("\nPROCESSED DATASET SAVED SUCCESSFULLY!")

# ==========================================
# STEP 14 — BUSINESS INSIGHTS
# ==========================================

print("\nKEY FINDINGS")

print("1. Customers with high purchase frequency spend more.")
print("2. Certain customer groups show higher churn risk.")
print("3. Customer segmentation identifies premium users.")
print("4. High-value customers contribute significantly to revenue.")

# ==========================================
# STEP 15 — RECOMMENDATIONS
# ==========================================

print("\nRECOMMENDATIONS")

print("1. Personalized Marketing Campaigns")
print("2. Loyalty Reward Programs")
print("3. Re-engagement Strategies")
print("4. Product Recommendation Systems")
print("5. Seasonal Promotional Offers")

